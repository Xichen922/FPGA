// Dual25K:31=A master,32=B slave. Use only this active CST. See wiring.csv.
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "reset_n" G8;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// MX matrix: J5-9/10/11/12 rows; J4-6/8/10 and J6-9 columns.
IO_LOC "kb_row[0]" E11;
IO_PORT "kb_row[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "kb_row[1]" E10;
IO_PORT "kb_row[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "kb_row[2]" A11;
IO_PORT "kb_row[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "kb_row[3]" A10;
IO_PORT "kb_row[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "kb_col[0]" C10;
IO_PORT "kb_col[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "kb_col[1]" B10;
IO_PORT "kb_col[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "kb_col[2]" D10;
IO_PORT "kb_col[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "kb_col[3]" G7;
IO_PORT "kb_col[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC "mcp_cs_n" H5;
IO_PORT "mcp_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "mcp_sclk" J5;
IO_PORT "mcp_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "mcp_mosi" H8;
IO_PORT "mcp_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "mcp_miso" H7;
IO_PORT "mcp_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "encoder_s1" K5;
IO_PORT "encoder_s1" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "encoder_s2" L5;
IO_PORT "encoder_s2" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "i2s_bclk" G11;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "i2s_lrck" D11;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "i2s_dout" B11;
IO_PORT "i2s_dout" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "link_cs_n" K11;
IO_PORT "link_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "link_sclk" L11;
IO_PORT "link_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "link_mosi" C11;
IO_PORT "link_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "link_miso" G10;
IO_PORT "link_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// TTP229 separate timbre pad: remaining J6 pins. LED on spare J3 GPIO.
IO_LOC "touch_scl" F5;
IO_PORT "touch_scl" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "touch_sdo" G5;
IO_PORT "touch_sdo" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "led_fill_en" K4;
IO_PORT "led_fill_en" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3 DRIVE=4;
