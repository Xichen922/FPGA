// Dual25K:31=A master,38=B slave. HC-06 has a separate UART on J6-9/11.
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// External W25Q64 on Dock J3-1..4, verified in example46.
IO_LOC "flash_cs_n" K2;
IO_PORT "flash_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "flash_sclk" K1;
IO_PORT "flash_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "flash_mosi" L1;
IO_PORT "flash_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "flash_miso" L2;
IO_PORT "flash_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "reset_n" G8;
IO_PORT "reset_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "audio_bclk" E11;
IO_PORT "audio_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "audio_lrck" E10;
IO_PORT "audio_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "audio_din" K5;
IO_PORT "audio_din" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "link_cs_n" H5;
IO_PORT "link_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "link_sclk" J5;
IO_PORT "link_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "link_mosi" H8;
IO_PORT "link_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "link_miso" H7;
IO_PORT "link_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "uart_tx" L5;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "uart_rx" G10;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_rx" G7;
IO_PORT "bt_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "bt_tx" F5;
IO_PORT "bt_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "ultrasonic_trig" K11;
IO_PORT "ultrasonic_trig" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "ultrasonic_echo" L11;
IO_PORT "ultrasonic_echo" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "i2s_bclk" G11;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "i2s_lrck" D11;
IO_PORT "i2s_lrck" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "i2s_dout" B11;
IO_PORT "i2s_dout" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "dac_xsmt" C11;
IO_PORT "dac_xsmt" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
// J4-6/J4-8: active-high external LEDs (each with a series resistor to GND).
IO_LOC "guide_led_low" C10;
IO_PORT "guide_led_low" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "guide_led_high" B10;
IO_PORT "guide_led_high" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
